                "manuallySelectedPrivateDnsZone": "[if(equals(if(empty(steps('basics').enclaveExistsQuery.data), steps('basics').privateDnsRegistrationTypeNoAve, steps('basics').privateDnsRegistrationTypeAve), 'manuallySelectZone'), steps('basics').manualPrivateDnsZoneSelector.id, '')]",
