{
    "$schema": "https://schema.management.azure.com/schemas/2021-09-09/uiFormDefinition.schema.json",
    "view": {
        "kind": "Form",
        "properties": {
            "title": "Key Vault",
            "steps": [
                {
                    "name": "basics",
                    "label": "Basics",
                    "elements": [
                        { "name": "subscriptionApi", "type": "Microsoft.Solutions.ArmApiControl", "request": { "method": "GET", "path": "/subscriptions?api-version=2020-01-01" } },
                        {
                            "name": "mgEntities",
                            "type": "Microsoft.Solutions.ArmApiControl",
                            "request": {
                                "method": "POST",
                                "path": "/providers/Microsoft.Management/getEntities?api-version=2020-05-01"
                            }
                        },
                        { "name": "subscriptionSelector", "type": "Microsoft.Common.DropDown", "label": "Subscription", "filter": true, "toolTip": "Select the Azure subscription where resources will be deployed.", "constraints": { "allowedValues": "[map(steps('basics').subscriptionApi.value, (item) => parse(concat('{\"label\":\"', item.displayName, ' (', item.subscriptionId, ')\",\"value\":\"', item.subscriptionId, '\"}')))]", "required": true }, "visible": true },
                        { "name": "msisrLookup", "type": "Microsoft.Solutions.ArmApiControl", "condition": "[not(empty(steps('basics').subscriptionSelector))]", "request": { "method": "POST", "path": "/providers/Microsoft.ResourceGraph/resources?api-version=2021-03-01", "body": { "subscriptions": ["[steps('basics').subscriptionSelector]"], "query": "ResourceContainers | where type == 'microsoft.resources/subscriptions' | mv-expand mgChain = properties.managementGroupAncestorsChain | extend mgName = tostring(mgChain.name) | summarize matchingManagementGroups = countif(mgName matches regex '^[a-z][a-z0-9]{2,3}lz[0-9]{0,2}$') | project MSISR = todynamic(iff(matchingManagementGroups > 0, 'true', 'false'))", "options": { "resultFormat": "objectArray" } } } },
                        { "name": "enclaveExistsQuery", "type": "Microsoft.Solutions.ArmApiControl", "condition": "[not(empty(steps('basics').subscriptionSelector))]", "request": { "method": "POST", "path": "/providers/Microsoft.ResourceGraph/resources?api-version=2021-03-01", "body": { "subscriptions": ["[steps('basics').subscriptionSelector]"], "query": "Resources | where type =~ 'microsoft.mission/virtualenclaves'", "options": { "resultFormat": "objectArray" } } } },
                        { "name": "enclaveSelector", "type": "Microsoft.Common.DropDown", "label": "Azure Enclave enclave", "filter": true, "toolTip": "Select the Azure Enclave. Enclaves provide network isolation and policy enforcement.", "constraints": { "allowedValues": "[map(steps('basics').enclaveExistsQuery.data, (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.id, '\"}')))]", "required": true }, "visible": "[and(not(empty(steps('basics').subscriptionSelector)), not(empty(steps('basics').enclaveExistsQuery.data)))]" },
                        { "name": "noEnclaveLocationsApi", "type": "Microsoft.Solutions.ArmApiControl", "condition": "[and(not(empty(steps('basics').subscriptionSelector)), empty(steps('basics').enclaveExistsQuery.data))]", "request": { "method": "GET", "path": "[concat('/subscriptions/', steps('basics').subscriptionSelector, '/locations?api-version=2022-12-01')]" } },
                        { "name": "noEnclaveLocation", "type": "Microsoft.Common.DropDown", "label": "Region", "filter": true, "toolTip": "Select the Azure region. Choose a region that meets data residency and compliance requirements.", "constraints": { "allowedValues": "[map(filter(steps('basics').noEnclaveLocationsApi.value, (item) => equals(item.metadata.regionType, 'Physical')), (item) => parse(concat('{\"label\":\"', item.displayName, '\",\"value\":\"', item.name, '\"}')))]", "required": "[and(not(empty(steps('basics').subscriptionSelector)), empty(steps('basics').enclaveExistsQuery.data))]" }, "visible": "[and(not(empty(steps('basics').subscriptionSelector)), empty(steps('basics').enclaveExistsQuery.data))]" },
                        { "name": "noEnclaveRgToggle", "type": "Microsoft.Common.OptionsGroup", "label": "Resource Group", "defaultValue": "Use Existing", "toolTip": "Choose to deploy into an existing resource group or create a new one.", "constraints": { "allowedValues": [{ "label": "Use Existing", "value": "useExisting" }, { "label": "Create New", "value": "createNew" }], "required": true }, "visible": "[and(not(empty(steps('basics').subscriptionSelector)), empty(steps('basics').enclaveExistsQuery.data))]" },
                        { "name": "noEnclaveExistingRgApi", "type": "Microsoft.Solutions.ArmApiControl", "condition": "[and(not(empty(steps('basics').subscriptionSelector)), empty(steps('basics').enclaveExistsQuery.data), equals(steps('basics').noEnclaveRgToggle, 'useExisting'))]", "request": { "method": "GET", "path": "[concat('/subscriptions/', steps('basics').subscriptionSelector, '/resourceGroups?api-version=2021-04-01')]" } },
                        { "name": "noEnclaveExistingRg", "type": "Microsoft.Common.DropDown", "label": "Existing Resource Group", "filter": true, "toolTip": "Select an existing resource group in the chosen subscription.", "constraints": { "allowedValues": "[map(steps('basics').noEnclaveExistingRgApi.value, (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.name, '\"}')))]", "required": "[and(not(empty(steps('basics').subscriptionSelector)), empty(steps('basics').enclaveExistsQuery.data), equals(steps('basics').noEnclaveRgToggle, 'useExisting'))]" }, "visible": "[and(not(empty(steps('basics').subscriptionSelector)), empty(steps('basics').enclaveExistsQuery.data), equals(steps('basics').noEnclaveRgToggle, 'useExisting'))]" },
                        { "name": "noEnclaveNewRgName", "type": "Microsoft.Common.TextBox", "label": "New Resource Group Name", "toolTip": "Enter a name for the new resource group.", "constraints": { "required": true, "validations": [{ "regex": "^[a-zA-Z0-9._()\\-]{1,90}$", "message": "1-90 chars. Only alphanumerics, periods, underscores, hyphens, and parentheses are allowed." }] }, "visible": "[and(not(empty(steps('basics').subscriptionSelector)), empty(steps('basics').enclaveExistsQuery.data), equals(steps('basics').noEnclaveRgToggle, 'createNew'))]" },
                        { "name": "newRgExistsCheckApi", "type": "Microsoft.Solutions.ArmApiControl", "condition": "[and(not(empty(steps('basics').noEnclaveNewRgName)), equals(steps('basics').noEnclaveRgToggle, 'createNew'))]", "request": { "method": "GET", "path": "[concat('/subscriptions/', steps('basics').subscriptionSelector, '/resourceGroups/', steps('basics').noEnclaveNewRgName, '?api-version=2021-04-01')]" } },
                        { "name": "rgLocationConflictWarning", "type": "Microsoft.Common.InfoBox", "visible": "[and(equals(steps('basics').noEnclaveRgToggle, 'createNew'), not(empty(steps('basics').newRgExistsCheckApi.location)), not(equals(steps('basics').newRgExistsCheckApi.location, steps('basics').noEnclaveLocation)))]", "options": { "icon": "Error", "text": "[concat('Resource group \"', steps('basics').noEnclaveNewRgName, '\" already exists in ', steps('basics').newRgExistsCheckApi.location, ' but you selected ', steps('basics').noEnclaveLocation, '. Choose a different resource group name or select the matching region.')]" } },
                        { "name": "enclaveApi", "type": "Microsoft.Solutions.ArmApiControl", "condition": "[not(empty(steps('basics').enclaveSelector))]", "request": { "method": "GET", "path": "[concat(steps('basics').enclaveSelector, '?api-version=2025-05-01-preview')]" } },
                        { "name": "workloadUseExisting", "type": "Microsoft.Common.OptionsGroup", "label": "Azure Enclave workload", "defaultValue": "Use Existing", "toolTip": "Workloads organize related resources within an Enclave. Use an existing one or create a new.", "constraints": { "allowedValues": [{ "label": "Use Existing", "value": true }, { "label": "Create New", "value": false }], "required": true }, "visible": "[not(empty(steps('basics').enclaveExistsQuery.data))]" },
                        { "name": "workloadApi", "type": "Microsoft.Solutions.ArmApiControl", "condition": "[and(steps('basics').workloadUseExisting, not(empty(steps('basics').enclaveSelector)))]", "request": { "method": "GET", "path": "[concat(steps('basics').enclaveSelector, '/workloads?api-version=2025-05-01-preview')]" } },
                        { "name": "workload", "type": "Microsoft.Common.DropDown", "label": "Existing Azure Enclave workload", "filter": true, "toolTip": "Select the Azure Enclave workload that will own this resource.", "constraints": { "allowedValues": "[map(steps('basics').workloadApi.value, (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.id, '\"}')))]", "required": true }, "visible": "[and(steps('basics').workloadUseExisting, not(empty(steps('basics').enclaveExistsQuery.data)))]" },
                        { "name": "newWorkloadName", "type": "Microsoft.Common.TextBox", "label": "New Azure Enclave workload Name", "toolTip": "Enter a name for the new Azure Enclave workload.", "constraints": { "required": true, "validations": [{ "regex": "^[a-zA-Z][a-zA-Z0-9-]{1,22}[a-zA-Z0-9]$", "message": "3-24 chars." }] }, "visible": "[and(not(steps('basics').workloadUseExisting), not(empty(steps('basics').enclaveExistsQuery.data)))]" },
                        { "name": "workloadResourceGroupUseExisting", "type": "Microsoft.Common.OptionsGroup", "label": "Azure Enclave workload RG", "defaultValue": "Use Existing", "toolTip": "Each workload has one or more resource groups. Use an existing one or create a new one.", "constraints": { "allowedValues": [{ "label": "Use Existing", "value": true }, { "label": "Create New", "value": false }], "required": "[steps('basics').workloadUseExisting]" }, "visible": "[and(steps('basics').workloadUseExisting, not(empty(steps('basics').enclaveExistsQuery.data)))]" },
                        { "name": "workloadResourceGroupApi", "type": "Microsoft.Solutions.ArmApiControl", "condition": "[not(empty(steps('basics').workloadApi))]", "request": { "method": "GET", "path": "[concat(steps('basics').workload, '?api-version=2025-05-01-preview')]" } },
                        { "name": "workloadResourceGroup", "type": "Microsoft.Common.DropDown", "label": "Existing Azure Enclave workload RG", "filter": true, "toolTip": "Select the resource group associated with the chosen workload.", "defaultValue": "[first(map(steps('basics').workloadResourceGroupApi.properties.resourceGroupCollection, (item) => parse(concat('{\"label\":\"', last(split(item, '/')), '\",\"value\":\"', last(split(item, '/')),'\"}'))))]", "constraints": { "allowedValues": "[map(steps('basics').workloadResourceGroupApi.properties.resourceGroupCollection, (item) => parse(concat('{\"label\":\"', last(split(item, '/')), '\",\"value\":\"', last(split(item, '/')),'\"}')))]", "required": "[if(steps('basics').workloadUseExisting, steps('basics').workloadResourceGroupUseExisting, false)]" }, "visible": "[and(if(steps('basics').workloadUseExisting, steps('basics').workloadResourceGroupUseExisting, false), not(empty(steps('basics').enclaveExistsQuery.data)))]" },
                        { "name": "newWorkloadResourceGroupName", "type": "Microsoft.Common.TextBox", "label": "New Azure Enclave workload RG Name", "toolTip": "Enter a name for the new workload resource group.", "constraints": { "required": true, "validations": [{ "regex": "^[a-zA-Z][a-zA-Z0-9-]{1,22}[a-zA-Z0-9]$", "message": "3-24 chars." }] }, "visible": "[and(if(steps('basics').workloadUseExisting, not(steps('basics').workloadResourceGroupUseExisting), true), not(empty(steps('basics').enclaveExistsQuery.data)))]" },
                        { "name": "keyvaultname", "type": "Microsoft.Common.TextBox", "label": "Key Vault Name", "toolTip": "Enter a name for the Key Vault.", "constraints": { "required": true, "validations": [{ "regex": "^[a-zA-Z][a-zA-Z0-9-]{1,22}[a-zA-Z0-9]$", "message": "Key Vault names must be 3-24 characters, start with a letter, end with a letter or number, and only contain alphanumerics and hyphens." }] }, "visible": true },
                        { "name": "skuname", "type": "Microsoft.Common.DropDown", "label": "Key Vault SKU", "defaultValue": "Standard", "toolTip": "Select the SKU for the Key Vault.", "constraints": { "allowedValues": [{ "label": "Standard", "value": "Standard" }, { "label": "Premium (HSM)", "value": "Premium" }], "required": true }, "visible": true },
                        { "name": "softDeleteTextBlock", "type": "Microsoft.Common.TextBlock", "visible": true, "options": { "text": "Soft delete protection is enabled by default on all key vaults in Azure. This feature allows you to either recover or permanently delete a key vault and secrets for the duration of the retention period." } },
                        { "name": "softDeleteRetentionInDays", "type": "Microsoft.Common.TextBox", "label": "Soft Delete Retention in Days", "defaultValue": "90", "toolTip": "Enter a value between 7 and 90 days", "constraints": { "required": true, "validations": [{ "regex": "^(?:[7-9]|[1-8][0-9]|90)$", "message": "Enter between 7 and 90 days" }] }, "visible": true },
                        { "name": "softDeleteTextBlock2", "type": "Microsoft.Common.TextBlock", "visible": true, "options": { "text": "To enforce a mandatory retention period and prevent the permanent deletion of key vaults or secrets prior to the retention period elapsing, you can turn on purge protection." } },
                        { "name": "purgeProtectionInfoBox", "type": "Microsoft.Common.InfoBox", "visible": "[steps('basics').enablePurgeProtection]", "options": { "icon": "Warning", "text": "Please confirm you understand the impact of enabling Purge Protection. It will make the vault and secrets immutable for the duration of the soft delete retention period." } },
                        { "name": "enablePurgeProtection", "type": "Microsoft.Common.OptionsGroup", "label": "Enable Purge Protection", "defaultValue": "False", "toolTip": "Select whether to enable purge protection for the Key Vault.", "constraints": { "allowedValues": [{ "label": "True", "value": true }, { "label": "False", "value": "" }], "required": true }, "visible": true },
                        { "name": "generateKeys", "type": "Microsoft.Common.DropDown", "label": "Generate Keys in Key Vault?", "defaultValue": "No", "toolTip": "Select whether to generate keys in the Key Vault.", "constraints": { "allowedValues": [{ "label": "Yes", "value": true }, { "label": "No", "value": false }], "required": true }, "visible": true },
                        { "name": "keys", "type": "Microsoft.Common.EditableGrid", "ariaLabel": "Enter key information", "label": "Keys", "required": "[if(equals(steps('basics').generateKeys, true), true, false)]", "visible": "[if(equals(steps('basics').generateKeys, true), true, false)]", "constraints": { "width": "Full", "rows": { "count": { "min": 1, "max": 20 } }, "columns": [{ "id": "name", "header": "Name", "width": "1fr", "element": { "type": "Microsoft.Common.TextBox", "placeholder": "Key Name", "constraints": { "required": true, "validations": [{ "regex": "^[a-z0-9A-Z][a-z0-9A-Z_.-]{0,78}[a-z0-9A-Z_]$", "message": "The name must begin with a letter or number, end with a letter, number or underscore, and may contain only letters, numbers, underscores, periods, or hyphens." }] } } }, { "id": "keySize", "header": "keySize", "width": "1fr", "element": { "name": "dropDown1", "type": "Microsoft.Common.DropDown", "placeholder": "Select a Key Size...", "defaultValue": "4096", "constraints": { "allowedValues": [{ "label": "2048", "value": "2048" }, { "label": "3072", "value": "3072" }, { "label": "4096", "value": "4096" }], "required": true } } }, { "id": "keyType", "header": "keyType", "width": "1fr", "element": { "name": "dropDown1", "type": "Microsoft.Common.DropDown", "placeholder": "Select a Key Type...", "defaultValue": "RSA", "constraints": { "allowedValues": [{ "label": "RSA", "value": "RSA" }, { "label": "EC", "value": "EC" }], "required": true } } }] } },
                        { "name": "noEnclaveVnetListApi", "type": "Microsoft.Solutions.ArmApiControl", "condition": "[and(not(empty(steps('basics').subscriptionSelector)), empty(steps('basics').enclaveExistsQuery.data))]", "request": { "method": "GET", "path": "[concat('/subscriptions/', steps('basics').subscriptionSelector, '/providers/Microsoft.Network/virtualNetworks?api-version=2023-09-01')]" } },
                        { "name": "noEnclaveVnetSelector", "type": "Microsoft.Common.DropDown", "label": "Virtual Network", "toolTip": "Select the Virtual Network for private endpoint connectivity.", "filter": true, "constraints": { "allowedValues": "[map(steps('basics').noEnclaveVnetListApi.value, (item) => parse(concat('{\"label\":\"', item.name, ' (', first(skip(split(item.id, '/'), 4)), ')\",\"value\":\"', item.id, '\"}')))]", "required": "[and(not(empty(steps('basics').subscriptionSelector)), empty(steps('basics').enclaveExistsQuery.data))]" }, "visible": "[and(not(empty(steps('basics').subscriptionSelector)), empty(steps('basics').enclaveExistsQuery.data))]" },
                        { "name": "noEnclaveVnetApi", "type": "Microsoft.Solutions.ArmApiControl", "condition": "[not(empty(steps('basics').noEnclaveVnetSelector))]", "request": { "method": "GET", "path": "[concat(steps('basics').noEnclaveVnetSelector, '?api-version=2023-09-01')]" } },
                        { "name": "noEnclaveSubnet", "type": "Microsoft.Common.DropDown", "label": "Subnet", "toolTip": "Select the subnet for the private endpoint. Subnets with service delegations are excluded.", "filter": true, "constraints": { "allowedValues": "[map(filter(steps('basics').noEnclaveVnetApi.properties.subnets, (item) => empty(item.properties.delegations)), (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.id, '\"}')))]", "required": "[and(not(empty(steps('basics').subscriptionSelector)), empty(steps('basics').enclaveExistsQuery.data))]" }, "visible": "[and(not(empty(steps('basics').subscriptionSelector)), empty(steps('basics').enclaveExistsQuery.data), not(empty(steps('basics').noEnclaveVnetSelector)))]" },
                        { "name": "crossRegionWarning", "type": "Microsoft.Common.InfoBox", "visible": "[and(empty(steps('basics').enclaveExistsQuery.data), not(empty(steps('basics').noEnclaveVnetApi.location)), not(equals(steps('basics').noEnclaveVnetApi.location, steps('basics').noEnclaveLocation)))]", "options": { "icon": "Info", "text": "[concat('The selected Virtual Network is in ', steps('basics').noEnclaveVnetApi.location, ' but the deployment region is ', steps('basics').noEnclaveLocation, '. The resource will be created in ', steps('basics').noEnclaveLocation, ' and the private endpoint will be created in ', steps('basics').noEnclaveVnetApi.location, '. This is supported but please confirm this is the intended configuration.')]" } },
                        { "name": "virtualNetworkApi", "type": "Microsoft.Solutions.ArmApiControl", "condition": "[not(empty(steps('basics').enclaveApi))]", "request": { "method": "GET", "path": "[concat(first(filter(steps('basics').enclaveApi.properties.resourceCollection, (item) => contains(item, 'microsoft.network/virtualnetworks'))), '?api-version=2023-05-01')]" } },
                        { "name": "virtualNetwork", "type": "Microsoft.Common.DropDown", "label": "Virtual Network", "toolTip": "Virtual Network associated with the selected Enclave for private endpoint connectivity.", "defaultValue": "[steps('basics').virtualNetworkApi.name]", "constraints": { "allowedValues": "[if(empty(steps('basics').virtualNetworkApi.name), parse('[]'), parse(concat('[{\"label\":\"', steps('basics').virtualNetworkApi.name, '\",\"value\":\"', steps('basics').virtualNetworkApi.id, '\"}]')))]", "required": true }, "visible": "[not(empty(steps('basics').enclaveExistsQuery.data))]" },
                        { "name": "subnet", "type": "Microsoft.Common.DropDown", "label": "Subnet", "toolTip": "Select the subnet for the private endpoint. Subnets with service delegations are excluded.", "constraints": { "allowedValues": "[map(filter(steps('basics').virtualNetworkApi.properties.subnets, (item) => empty(item.properties.delegations)), (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.id, '\"}')))]", "required": true }, "visible": "[not(empty(steps('basics').enclaveExistsQuery.data))]" },
                        { "name": "dnsZoneQueryControl", "type": "Microsoft.Solutions.ArmApiControl", "condition": "[not(empty(if(empty(steps('basics').enclaveExistsQuery.data), steps('basics').noEnclaveVnetApi.name, steps('basics').virtualNetworkApi.name)))]", "request": { "method": "POST", "path": "/providers/Microsoft.ResourceGraph/resources?api-version=2021-03-01", "body": { "query": "[concat('Resources | where type =~ \"microsoft.network/privatednszones/virtualnetworklinks\" | where properties.virtualNetwork.id contains \"', if(empty(steps('basics').enclaveExistsQuery.data), steps('basics').noEnclaveVnetApi.name, steps('basics').virtualNetworkApi.name), '\" | join kind=leftouter (ResourceContainers | where type == \"microsoft.resources/subscriptions\" | project subscriptionId, subName = name) on subscriptionId | extend zoneName = tostring(split(id, \"/\")[8]) | extend zoneId = extract(\"(?i)(.*)/virtualNetworkLinks\", 1, id) | project name = zoneName, id = zoneId, subName, subscriptionId')]", "options": { "resultFormat": "objectArray" } } } },
                        { "name": "privateDnsRegistrationTypeAve", "type": "Microsoft.Common.OptionsGroup", "label": "Private DNS Registration", "defaultValue": "Register with DNS zone linked to Enclave Virtual Network (recommended)", "toolTip": "Choose how the private endpoint DNS record is registered for name resolution within your network.", "constraints": { "allowedValues": [{ "label": "Register with DNS zone linked to Enclave Virtual Network (recommended)", "value": "defaultManagedResourceGroupZone" }, { "label": "Register with manually-selected DNS zone", "value": "manuallySelectZone" }, { "label": "Do not register", "value": "doNotRegister" }], "required": true }, "visible": "[and(not(empty(steps('basics').enclaveExistsQuery.data)), not(greater(length(filter(coalesce(steps('basics').mgEntities.value, parse('[]')), (mg) => and(equals(mg.type, 'Microsoft.Management/managementGroups'), or(endsWith(toLower(mg.name), 'lz-lzs'), endsWith(toLower(mg.name), 'lz7-lzs')), or(endsWith(toLower(last(split(coalesce(mg.properties.parent.id, ''), '/'))), 'lz'), endsWith(toLower(last(split(coalesce(mg.properties.parent.id, ''), '/'))), 'lz7'))))), 0)))]" },
                        { "name": "privateDnsRegistrationTypeNoAve", "type": "Microsoft.Common.OptionsGroup", "label": "Private DNS Registration", "defaultValue": "Register with DNS zone linked to Virtual Network (recommended)", "toolTip": "Choose how the private endpoint DNS record is registered for name resolution within your network.", "constraints": { "allowedValues": [{ "label": "Register with DNS zone linked to Virtual Network (recommended)", "value": "defaultManagedResourceGroupZone" }, { "label": "Register with manually-selected DNS zone", "value": "manuallySelectZone" }, { "label": "Do not register", "value": "doNotRegister" }], "required": true }, "visible": "[and(empty(steps('basics').enclaveExistsQuery.data), not(greater(length(filter(coalesce(steps('basics').mgEntities.value, parse('[]')), (mg) => and(equals(mg.type, 'Microsoft.Management/managementGroups'), or(endsWith(toLower(mg.name), 'lz-lzs'), endsWith(toLower(mg.name), 'lz7-lzs')), or(endsWith(toLower(last(split(coalesce(mg.properties.parent.id, ''), '/'))), 'lz'), endsWith(toLower(last(split(coalesce(mg.properties.parent.id, ''), '/'))), 'lz7'))))), 0)))]" },
                        { "name": "linkedDnsZoneDoesNotExistTextBlock", "type": "Microsoft.Common.InfoBox", "visible": "[and(not(empty(if(empty(steps('basics').enclaveExistsQuery.data), steps('basics').noEnclaveVnetApi.name, steps('basics').virtualNetworkApi.name))), if(empty(filter(steps('basics').dnsZoneQueryControl.data, (item) => contains(item.name, 'privatelink.vaultcore'))), true, false), equals(if(empty(steps('basics').enclaveExistsQuery.data), steps('basics').privateDnsRegistrationTypeNoAve, steps('basics').privateDnsRegistrationTypeAve), 'defaultManagedResourceGroupZone'))]", "options": { "icon": "Warning", "text": "No privatelink.vaultcore zone found. A new one will be created." } },
                        { "name": "linkedDnsZoneExistsTextBlock", "type": "Microsoft.Common.InfoBox", "visible": "[and(not(empty(filter(steps('basics').dnsZoneQueryControl.data, (item) => contains(item.name, 'privatelink.vaultcore')))), equals(if(empty(steps('basics').enclaveExistsQuery.data), steps('basics').privateDnsRegistrationTypeNoAve, steps('basics').privateDnsRegistrationTypeAve), 'defaultManagedResourceGroupZone'))]", "options": { "icon": "Info", "text": "[concat('An existing privatelink.vaultcore zone was found linked to the selected Virtual Network. Zone: ', first(filter(steps('basics').dnsZoneQueryControl.data, (item) => contains(item.name, 'privatelink.vaultcore'))).name, ' (Subscription: ', first(filter(steps('basics').dnsZoneQueryControl.data, (item) => contains(item.name, 'privatelink.vaultcore'))).subName, ')')]" } },
                        { "name": "dnsZoneResourceGroupApi", "type": "Microsoft.Solutions.ArmApiControl", "condition": "[and(not(empty(if(empty(steps('basics').enclaveExistsQuery.data), steps('basics').noEnclaveVnetApi.name, steps('basics').virtualNetworkApi.name))), if(empty(filter(steps('basics').dnsZoneQueryControl.data, (item) => contains(item.name, 'privatelink.vaultcore'))), true, false), equals(if(empty(steps('basics').enclaveExistsQuery.data), steps('basics').privateDnsRegistrationTypeNoAve, steps('basics').privateDnsRegistrationTypeAve), 'defaultManagedResourceGroupZone'))]", "request": { "method": "GET", "path": "[concat('/subscriptions/', steps('basics').subscriptionSelector, '/resourceGroups?api-version=2021-04-01')]" } },
                        { "name": "dnsZoneResourceGroupDropdown", "type": "Microsoft.Common.DropDown", "label": "Private DNS Zone RG", "filter": true, "toolTip": "Select the resource group where the new Private DNS Zone will be created.", "constraints": { "allowedValues": "[map(steps('basics').dnsZoneResourceGroupApi.value, (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.id, '\"}')))]", "required": true }, "visible": "[and(not(empty(if(empty(steps('basics').enclaveExistsQuery.data), steps('basics').noEnclaveVnetApi.name, steps('basics').virtualNetworkApi.name))), if(empty(filter(steps('basics').dnsZoneQueryControl.data, (item) => contains(item.name, 'privatelink.vaultcore'))), true, false), equals(if(empty(steps('basics').enclaveExistsQuery.data), steps('basics').privateDnsRegistrationTypeNoAve, steps('basics').privateDnsRegistrationTypeAve), 'defaultManagedResourceGroupZone'))]" },
                        { "name": "manualPrivateDnsZoneSelector", "type": "Microsoft.Solutions.ResourceSelector", "label": "Manually Select Private DNS Zone", "toolTip": "Select an existing Private DNS Zone for private endpoint name resolution.", "resourceType": "Microsoft.Network/privateDnsZones", "constraints": { "required": true }, "visible": "[equals(if(empty(steps('basics').enclaveExistsQuery.data), steps('basics').privateDnsRegistrationTypeNoAve, steps('basics').privateDnsRegistrationTypeAve), 'manuallySelectZone')]" },
                        { "name": "enableDiagnostics", "type": "Microsoft.Common.OptionsGroup", "label": "Enable Diagnostic Settings", "defaultValue": "No", "toolTip": "Send diagnostic logs and metrics to a Log Analytics workspace for monitoring and troubleshooting.", "constraints": { "allowedValues": [{ "label": "Yes", "value": true }, { "label": "No", "value": false }], "required": true }, "visible": true },
                        { "name": "workspace", "type": "Microsoft.Solutions.ResourceSelector", "label": "Log Analytics Workspace", "toolTip": "Select the Log Analytics workspace that will receive diagnostic logs and metrics.", "resourceType": "Microsoft.OperationalInsights/workspaces", "constraints": { "required": true }, "options": { "filter": { "subscription": "onBasics", "location": "onBasics" } }, "visible": "[steps('basics').enableDiagnostics]" },
                        { "name": "enableTelemetry", "type": "Microsoft.Common.OptionsGroup", "label": "Enable Usage Telemetry", "defaultValue": "Enabled", "toolTip": "Anonymous usage telemetry helps Microsoft improve the Service Catalog. No customer data is collected.", "constraints": { "allowedValues": [{ "label": "Enabled", "value": true }, { "label": "Disabled", "value": false }], "required": true }, "visible": "[not(greater(length(filter(coalesce(steps('basics').mgEntities.value, parse('[]')), (mg) => and(equals(mg.type, 'Microsoft.Management/managementGroups'), or(endsWith(toLower(mg.name), 'lz-lzs'), endsWith(toLower(mg.name), 'lz7-lzs')), or(endsWith(toLower(last(split(coalesce(mg.properties.parent.id, ''), '/'))), 'lz'), endsWith(toLower(last(split(coalesce(mg.properties.parent.id, ''), '/'))), 'lz7'))))), 0))]" }
                    ]
