                { "name": "tags", "label": "Tags", "elements": [{ "name": "tagsByResource", "type": "Microsoft.Common.TagsByResource", "resources": ["Microsoft.KeyVault/vaults", "Microsoft.Network/privateEndpoints"] }] }
            ]
