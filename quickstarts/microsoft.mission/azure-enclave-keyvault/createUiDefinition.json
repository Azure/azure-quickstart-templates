                "workloadResourceGroup": "[if(empty(steps('basics').enclaveExistsQuery.data), if(equals(steps('basics').noEnclaveRgToggle, 'useExisting'), steps('basics').noEnclaveExistingRg, steps('basics').noEnclaveNewRgName), if(steps('basics').workloadUseExisting, if(steps('basics').workloadResourceGroupUseExisting, steps('basics').workloadResourceGroup, steps('basics').newWorkloadResourceGroupName), steps('basics').newWorkloadResourceGroupName))]",
                "workloadUseExisting": "[if(empty(steps('basics').enclaveExistsQuery.data), false, steps('basics').workloadUseExisting)]",
                "workloadResourceGroupUseExisting": "[if(empty(steps('basics').enclaveExistsQuery.data), equals(steps('basics').noEnclaveRgToggle, 'useExisting'), if(steps('basics').workloadUseExisting, steps('basics').workloadResourceGroupUseExisting, false))]"
