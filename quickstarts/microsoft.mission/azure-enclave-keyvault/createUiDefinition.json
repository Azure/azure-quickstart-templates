                "isMsisrTenant": "[greater(length(filter(coalesce(steps('basics').mgEntities.value, parse('[]')), (mg) => and(equals(mg.type, 'Microsoft.Management/managementGroups'), or(endsWith(toLower(mg.name), 'lz-lzs'), endsWith(toLower(mg.name), 'lz7-lzs')), or(endsWith(toLower(last(split(coalesce(mg.properties.parent.id, ''), '/'))), 'lz'), endsWith(toLower(last(split(coalesce(mg.properties.parent.id, ''), '/'))), 'lz7'))))), 0)]",
                "tagsByResource": "[steps('tags').tagsByResource]",
                "newWorkloadName": "[steps('basics').newWorkloadName]",
