{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "usgovvirginia"
    },
    "storageAccountName": {
      "value": "<storage-account-name>"
    },
    "workloadResourceGroup": {
      "value": "<workload-resource-group-name>"
    },
    "workloadUseExisting": {
      "value": false
    },
    "workloadResourceGroupUseExisting": {
      "value": false
    },
    "vnetRG": {
      "value": "<virtual-network-resource-group>"
    },
    "vnetName": {
      "value": "<virtual-network-name>"
    },
    "subnetName": {
      "value": "<subnet-name>"
    },
    "keyVaultUseExisting": {
      "value": true
    },
    "keyVaultId": {
      "value": "/subscriptions/<subscription-id>/resourceGroups/<keyvault-rg>/providers/Microsoft.KeyVault/vaults/<keyvault-name>"
    },
    "keyName": {
      "value": "<key-name>"
    },
    "umiUseExisting": {
      "value": true
    },
    "umiId": {
      "value": "/subscriptions/<subscription-id>/resourceGroups/<identity-rg>/providers/Microsoft.ManagedIdentity/userAssignedIdentities/<identity-name>"
    },
    "privateDnsRegistrationType": {
      "value": "doNotRegister"
    },
    "enableTelemetry": {
      "value": true
    }
  }
}
