{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "6146710939370452361"
    }
  },
  "parameters": {
    "dnsZoneName": {
      "type": "string",
      "defaultValue": "[format('tm-linked-{0}.example.com', uniqueString(resourceGroup().id))]",
      "metadata": {
        "description": "The public DNS zone name."
      }
    },
    "recordName": {
      "type": "string",
      "defaultValue": "www",
      "metadata": {
        "description": "The relative record name. Use @ for the zone apex."
      }
    },
    "trafficManagerProfileName": {
      "type": "string",
      "defaultValue": "tm-linked-profile",
      "metadata": {
        "description": "The Traffic Manager profile name."
      }
    },
    "trafficManagerDnsName": {
      "type": "string",
      "defaultValue": "[format('tm-linked-{0}', uniqueString(resourceGroup().id))]",
      "metadata": {
        "description": "A globally unique relative DNS name for the Traffic Manager profile."
      }
    },
    "endpoint1IpAddress": {
      "type": "string",
      "metadata": {
        "description": "The public IPv4 address of the primary endpoint."
      }
    },
    "endpoint2IpAddress": {
      "type": "string",
      "metadata": {
        "description": "The public IPv4 address of the secondary endpoint."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Network/dnsZones",
      "apiVersion": "2018-05-01",
      "name": "[parameters('dnsZoneName')]",
      "location": "global"
    },
    {
      "type": "Microsoft.Network/trafficmanagerprofiles",
      "apiVersion": "2024-04-01-preview",
      "name": "[parameters('trafficManagerProfileName')]",
      "location": "global",
      "properties": {
        "profileStatus": "Enabled",
        "trafficRoutingMethod": "Priority",
        "recordType": "A",
        "dnsConfig": {
          "relativeName": "[parameters('trafficManagerDnsName')]",
          "ttl": 30
        },
        "monitorConfig": {
          "protocol": "HTTP",
          "port": 80,
          "path": "/",
          "intervalInSeconds": 30,
          "timeoutInSeconds": 10,
          "toleratedNumberOfFailures": 3
        },
        "endpoints": [
          {
            "name": "primary-endpoint",
            "type": "Microsoft.Network/trafficManagerProfiles/externalEndpoints",
            "properties": {
              "endpointStatus": "Enabled",
              "target": "[parameters('endpoint1IpAddress')]",
              "priority": 1
            }
          },
          {
            "name": "secondary-endpoint",
            "type": "Microsoft.Network/trafficManagerProfiles/externalEndpoints",
            "properties": {
              "endpointStatus": "Enabled",
              "target": "[parameters('endpoint2IpAddress')]",
              "priority": 2
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/dnsZones/A",
      "apiVersion": "2023-07-01-preview",
      "name": "[format('{0}/{1}', parameters('dnsZoneName'), parameters('recordName'))]",
      "properties": {
        "TTL": 30,
        "trafficManagementProfile": {
          "id": "[resourceId('Microsoft.Network/trafficmanagerprofiles', parameters('trafficManagerProfileName'))]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/dnsZones', parameters('dnsZoneName'))]",
        "[resourceId('Microsoft.Network/trafficmanagerprofiles', parameters('trafficManagerProfileName'))]"
      ]
    }
  ],
  "outputs": {
    "dnsZoneNameServers": {
      "type": "array",
      "value": "[reference(resourceId('Microsoft.Network/dnsZones', parameters('dnsZoneName')), '2018-05-01').nameServers]"
    },
    "linkedRecordResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/dnsZones/A', parameters('dnsZoneName'), parameters('recordName'))]"
    },
    "trafficManagerProfileResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/trafficmanagerprofiles', parameters('trafficManagerProfileName'))]"
    }
  }
}