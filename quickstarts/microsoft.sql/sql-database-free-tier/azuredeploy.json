{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "2853723507791742277"
    }
  },
  "parameters": {
    "serverName": {
      "type": "string",
      "defaultValue": "[format('sql-{0}', uniqueString(resourceGroup().id))]",
      "minLength": 1,
      "maxLength": 63,
      "metadata": {
        "description": "The globally unique name of the SQL logical server."
      }
    },
    "databaseName": {
      "type": "string",
      "defaultValue": "freeDatabase",
      "metadata": {
        "description": "The name of the new free tier SQL database."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources. Use the region of any existing free tier databases in the subscription."
      }
    },
    "administratorLogin": {
      "type": "string",
      "minLength": 1,
      "metadata": {
        "description": "The display name of an existing Microsoft Entra user, group, or application to configure as the SQL server administrator."
      }
    },
    "administratorObjectId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "metadata": {
        "description": "The object ID of the Microsoft Entra administrator in the subscription tenant. For an application, use the service principal object ID, not the application ID."
      }
    },
    "administratorPrincipalType": {
      "type": "string",
      "defaultValue": "User",
      "allowedValues": [
        "User",
        "Group",
        "Application"
      ],
      "metadata": {
        "description": "The type of Microsoft Entra principal to configure as the SQL server administrator."
      }
    },
    "clientIpAddress": {
      "type": "string",
      "minLength": 7,
      "maxLength": 15,
      "metadata": {
        "description": "The public IPv4 address of the client allowed through the SQL server firewall. Specify a single client address, not 0.0.0.0."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Sql/servers",
      "apiVersion": "2023-08-01",
      "name": "[parameters('serverName')]",
      "location": "[parameters('location')]",
      "properties": {
        "version": "12.0",
        "minimalTlsVersion": "1.2",
        "publicNetworkAccess": "Enabled",
        "administrators": {
          "administratorType": "ActiveDirectory",
          "principalType": "[parameters('administratorPrincipalType')]",
          "login": "[parameters('administratorLogin')]",
          "sid": "[parameters('administratorObjectId')]",
          "tenantId": "[subscription().tenantId]",
          "azureADOnlyAuthentication": true
        }
      }
    },
    {
      "type": "Microsoft.Sql/servers/firewallRules",
      "apiVersion": "2023-08-01",
      "name": "[format('{0}/{1}', parameters('serverName'), 'AllowClientIp')]",
      "properties": {
        "startIpAddress": "[parameters('clientIpAddress')]",
        "endIpAddress": "[parameters('clientIpAddress')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', parameters('serverName'))]"
      ]
    },
    {
      "type": "Microsoft.Sql/servers/databases",
      "apiVersion": "2023-08-01",
      "name": "[format('{0}/{1}', parameters('serverName'), parameters('databaseName'))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "GP_S_Gen5",
        "tier": "GeneralPurpose",
        "family": "Gen5",
        "capacity": 2
      },
      "properties": {
        "createMode": "Default",
        "maxSizeBytes": 34359738368,
        "minCapacity": "[json('0.5')]",
        "useFreeLimit": true,
        "freeLimitExhaustionBehavior": "AutoPause",
        "requestedBackupStorageRedundancy": "Local"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', parameters('serverName'))]"
      ]
    }
  ],
  "outputs": {
    "serverFullyQualifiedDomainName": {
      "type": "string",
      "metadata": {
        "description": "The fully qualified domain name of the SQL logical server."
      },
      "value": "[reference(resourceId('Microsoft.Sql/servers', parameters('serverName')), '2023-08-01').fullyQualifiedDomainName]"
    },
    "databaseName": {
      "type": "string",
      "metadata": {
        "description": "The name of the free tier SQL database."
      },
      "value": "[parameters('databaseName')]"
    },
    "databaseResourceId": {
      "type": "string",
      "metadata": {
        "description": "The resource ID of the free tier SQL database."
      },
      "value": "[resourceId('Microsoft.Sql/servers/databases', parameters('serverName'), parameters('databaseName'))]"
    }
  }
}