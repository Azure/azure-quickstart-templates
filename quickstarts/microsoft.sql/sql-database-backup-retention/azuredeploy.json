{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "1480722219215544946"
    }
  },
  "parameters": {
    "serverName": {
      "type": "string",
      "defaultValue": "[format('sql-{0}', uniqueString(resourceGroup().id))]",
      "minLength": 1,
      "maxLength": 63,
      "metadata": {
        "description": "The globally unique SQL logical server name."
      }
    },
    "databaseName": {
      "type": "string",
      "defaultValue": "retentionDatabase",
      "metadata": {
        "description": "The database name."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources."
      }
    },
    "administratorLogin": {
      "type": "string",
      "minLength": 1,
      "metadata": {
        "description": "The display name of an existing Microsoft Entra administrator."
      }
    },
    "administratorObjectId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "metadata": {
        "description": "The object ID of the existing Microsoft Entra administrator in the subscription tenant."
      }
    },
    "administratorPrincipalType": {
      "type": "string",
      "defaultValue": "User",
      "allowedValues": [
        "User",
        "Group",
        "Application"
      ],
      "metadata": {
        "description": "The Microsoft Entra administrator principal type."
      }
    },
    "clientIpAddress": {
      "type": "string",
      "minLength": 7,
      "maxLength": 15,
      "metadata": {
        "description": "The SQL client public IPv4 address. Do not use 0.0.0.0, which allows Azure services."
      }
    },
    "databaseSkuName": {
      "type": "string",
      "defaultValue": "S0",
      "metadata": {
        "description": "The paid Standard-tier database service objective."
      }
    },
    "retentionDays": {
      "type": "int",
      "defaultValue": 7,
      "minValue": 1,
      "maxValue": 35,
      "metadata": {
        "description": "Days of point-in-time restore retention."
      }
    },
    "weeklyRetention": {
      "type": "string",
      "defaultValue": "P1W",
      "metadata": {
        "description": "How long weekly full backups are retained, in ISO 8601 duration format. P1W retains each weekly backup for one week."
      }
    },
    "monthlyRetention": {
      "type": "string",
      "defaultValue": "P1M",
      "metadata": {
        "description": "How long monthly full backups are retained, in ISO 8601 duration format."
      }
    },
    "yearlyRetention": {
      "type": "string",
      "defaultValue": "P1Y",
      "metadata": {
        "description": "How long yearly full backups are retained, in ISO 8601 duration format."
      }
    },
    "weekOfYear": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "maxValue": 52,
      "metadata": {
        "description": "The week of the year whose full backup is retained as the yearly backup."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Sql/servers",
      "apiVersion": "2023-08-01",
      "name": "[parameters('serverName')]",
      "location": "[parameters('location')]",
      "properties": {
        "version": "12.0",
        "minimalTlsVersion": "1.2",
        "publicNetworkAccess": "Enabled",
        "administrators": {
          "administratorType": "ActiveDirectory",
          "azureADOnlyAuthentication": true,
          "principalType": "[parameters('administratorPrincipalType')]",
          "login": "[parameters('administratorLogin')]",
          "sid": "[parameters('administratorObjectId')]",
          "tenantId": "[subscription().tenantId]"
        }
      }
    },
    {
      "type": "Microsoft.Sql/servers/firewallRules",
      "apiVersion": "2023-08-01",
      "name": "[format('{0}/{1}', parameters('serverName'), 'AllowClientIp')]",
      "properties": {
        "startIpAddress": "[parameters('clientIpAddress')]",
        "endIpAddress": "[parameters('clientIpAddress')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', parameters('serverName'))]"
      ]
    },
    {
      "type": "Microsoft.Sql/servers/databases",
      "apiVersion": "2023-08-01",
      "name": "[format('{0}/{1}', parameters('serverName'), parameters('databaseName'))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('databaseSkuName')]",
        "tier": "Standard"
      },
      "properties": {
        "createMode": "Default",
        "requestedBackupStorageRedundancy": "Local"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', parameters('serverName'))]"
      ]
    },
    {
      "type": "Microsoft.Sql/servers/databases/backupShortTermRetentionPolicies",
      "apiVersion": "2023-08-01",
      "name": "[format('{0}/{1}/{2}', parameters('serverName'), parameters('databaseName'), 'default')]",
      "properties": {
        "retentionDays": "[parameters('retentionDays')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers/databases', parameters('serverName'), parameters('databaseName'))]"
      ]
    },
    {
      "type": "Microsoft.Sql/servers/databases/backupLongTermRetentionPolicies",
      "apiVersion": "2023-08-01",
      "name": "[format('{0}/{1}/{2}', parameters('serverName'), parameters('databaseName'), 'default')]",
      "properties": {
        "weeklyRetention": "[parameters('weeklyRetention')]",
        "monthlyRetention": "[parameters('monthlyRetention')]",
        "yearlyRetention": "[parameters('yearlyRetention')]",
        "weekOfYear": "[parameters('weekOfYear')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers/databases', parameters('serverName'), parameters('databaseName'))]"
      ]
    }
  ],
  "outputs": {
    "serverFullyQualifiedDomainName": {
      "type": "string",
      "metadata": {
        "description": "The SQL server fully qualified domain name."
      },
      "value": "[reference(resourceId('Microsoft.Sql/servers', parameters('serverName')), '2023-08-01').fullyQualifiedDomainName]"
    },
    "serverName": {
      "type": "string",
      "metadata": {
        "description": "The SQL logical server name."
      },
      "value": "[parameters('serverName')]"
    },
    "databaseName": {
      "type": "string",
      "metadata": {
        "description": "The database name."
      },
      "value": "[parameters('databaseName')]"
    },
    "databaseResourceId": {
      "type": "string",
      "metadata": {
        "description": "The database resource ID."
      },
      "value": "[resourceId('Microsoft.Sql/servers/databases', parameters('serverName'), parameters('databaseName'))]"
    }
  }
}